{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Radius, borders, elevation, focus. Most things are flat with a hairline; only floating things (nav on scroll, popovers, the phone) cast a shadow.",
  "radius": {
    "xs":    { "$type": "dimension", "$value": "0.25rem" },
    "sm":    { "$type": "dimension", "$value": "0.5rem" },
    "md":    { "$type": "dimension", "$value": "0.75rem" },
    "lg":    { "$type": "dimension", "$value": "1.125rem" },
    "xl":    { "$type": "dimension", "$value": "1.5rem" },
    "phone": { "$type": "dimension", "$value": "2.5rem" },
    "pill":  { "$type": "dimension", "$value": "62rem" }
  },
  "border": {
    "hairline": { "$type": "dimension", "$value": "1px" },
    "thick":    { "$type": "dimension", "$value": "2px" },
    "frame":    { "$type": "dimension", "$value": "0.5rem", "$description": "Phone bezel" }
  },
  "focus": {
    "width":  { "$type": "dimension", "$value": "2px" },
    "offset": { "$type": "dimension", "$value": "3px" }
  },
  "shadow": {
    "raised":  { "$type": "shadow", "$value": "0 1px 2px color-mix(in srgb, var(--color-shadow-color) 8%, transparent)" },
    "float":   { "$type": "shadow", "$value": "0 1px 2px color-mix(in srgb, var(--color-shadow-color) 6%, transparent), 0 12px 32px -12px color-mix(in srgb, var(--color-shadow-color) 22%, transparent)" },
    "phone":   { "$type": "shadow", "$value": "0 2px 4px color-mix(in srgb, var(--color-shadow-color) 6%, transparent), 0 32px 64px -24px color-mix(in srgb, var(--color-shadow-color) 32%, transparent)" }
  },
  "hatch": {
    "gap":  { "$type": "dimension", "$value": "0.4375rem", "$description": "Survey hatching on registered areas" },
    "line": { "$type": "dimension", "$value": "1px" }
  },
  "grid": {
    "cell": { "$type": "dimension", "$value": "2rem", "$description": "Faint survey grid behind hero and map" }
  }
}
