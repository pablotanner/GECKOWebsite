{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "4px rhythm. Inner spacing stays small and even; section spacing jumps. Breakpoints are listed for reference only: CSS media queries cannot read variables, so stylesheets write them in em (mobile-first, min-width).",
  "space": {
    "0":  { "$type": "dimension", "$value": "0" },
    "1":  { "$type": "dimension", "$value": "0.25rem" },
    "2":  { "$type": "dimension", "$value": "0.5rem" },
    "3":  { "$type": "dimension", "$value": "0.75rem" },
    "4":  { "$type": "dimension", "$value": "1rem" },
    "5":  { "$type": "dimension", "$value": "1.25rem" },
    "6":  { "$type": "dimension", "$value": "1.5rem" },
    "8":  { "$type": "dimension", "$value": "2rem" },
    "10": { "$type": "dimension", "$value": "2.5rem" },
    "12": { "$type": "dimension", "$value": "3rem" },
    "16": { "$type": "dimension", "$value": "4rem" },
    "20": { "$type": "dimension", "$value": "5rem" },
    "24": { "$type": "dimension", "$value": "6rem" }
  },
  "layout": {
    "gutter":      { "$type": "dimension", "$value": "clamp(1rem, 0.6rem + 2vw, 2.5rem)", "$description": "16px at 360px wide, per the brief" },
    "container":   { "$type": "dimension", "$value": "76rem" },
    "narrow":      { "$type": "dimension", "$value": "46rem" },
    "section-y":   { "$type": "dimension", "$value": "clamp(4.5rem, 3rem + 6vw, 9rem)" },
    "nav-height":  { "$type": "dimension", "$value": "3.75rem" },
    "tap-target":  { "$type": "dimension", "$value": "2.75rem", "$description": "44px minimum hit area" }
  },
  "breakpoint": {
    "sm": { "$type": "dimension", "$value": "30em",  "$description": "480" },
    "md": { "$type": "dimension", "$value": "48em",  "$description": "768: flow turns horizontal, videos side by side" },
    "lg": { "$type": "dimension", "$value": "64em",  "$description": "1024: full nav tabs, map + panel side by side" },
    "xl": { "$type": "dimension", "$value": "80em",  "$description": "1280" }
  },
  "z": {
    "base":    { "$type": "number", "$value": "0" },
    "raised":  { "$type": "number", "$value": "10" },
    "nav":     { "$type": "number", "$value": "50" },
    "popover": { "$type": "number", "$value": "60" },
    "overlay": { "$type": "number", "$value": "100" }
  }
}
