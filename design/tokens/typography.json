{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Type tokens. IBM Plex Sans for reading, JetBrains Mono for anything a machine would print: SSIDs, domains, coordinates, timestamps, certificate fields. Display sizes are fluid; display-1 is 2.5x-4.5x body.",
  "font": {
    "sans": { "$type": "fontFamily", "$value": "'IBM Plex Sans', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif" },
    "mono": { "$type": "fontFamily", "$value": "'JetBrains Mono', ui-monospace, 'Cascadia Mono', 'SF Mono', Menlo, monospace" },
    "weight-regular":  { "$type": "fontWeight", "$value": "400" },
    "weight-medium":   { "$type": "fontWeight", "$value": "500" },
    "weight-semibold": { "$type": "fontWeight", "$value": "600" },
    "weight-bold":     { "$type": "fontWeight", "$value": "700" }
  },
  "text": {
    "xs":        { "$type": "dimension", "$value": "0.75rem",  "$description": "12: map labels, legal" },
    "sm":        { "$type": "dimension", "$value": "0.875rem", "$description": "14: chips, captions, labels" },
    "base":      { "$type": "dimension", "$value": "1rem",     "$description": "16: UI text" },
    "body":      { "$type": "dimension", "$value": "1.0625rem","$description": "17: long-form reading" },
    "lead":      { "$type": "dimension", "$value": "clamp(1.125rem, 1.05rem + 0.4vw, 1.3125rem)", "$description": "18-21: hero sub-line, section intros" },
    "title":     { "$type": "dimension", "$value": "1.25rem",  "$description": "20: card and step titles" },
    "title-lg":  { "$type": "dimension", "$value": "clamp(1.375rem, 1.2rem + 0.8vw, 1.75rem)", "$description": "22-28" },
    "display-2": { "$type": "dimension", "$value": "clamp(2.125rem, 1.5rem + 2.8vw, 3.25rem)", "$description": "34-52: section headings (h2)" },
    "display-1": { "$type": "dimension", "$value": "clamp(2.625rem, 1.6rem + 4.8vw, 4.75rem)", "$description": "42-76: hero (h1, once per page)" }
  },
  "leading": {
    "display": { "$type": "number", "$value": "1.04" },
    "tight":   { "$type": "number", "$value": "1.2" },
    "snug":    { "$type": "number", "$value": "1.4" },
    "normal":  { "$type": "number", "$value": "1.6" }
  },
  "tracking": {
    "display": { "$type": "dimension", "$value": "-0.03em" },
    "title":   { "$type": "dimension", "$value": "-0.012em" },
    "normal":  { "$type": "dimension", "$value": "0" },
    "mono":    { "$type": "dimension", "$value": "-0.01em" },
    "caps":    { "$type": "dimension", "$value": "0.09em" }
  },
  "measure": {
    "display": { "$type": "dimension", "$value": "18ch" },
    "lead":    { "$type": "dimension", "$value": "54ch" },
    "prose":   { "$type": "dimension", "$value": "66ch" }
  }
}
