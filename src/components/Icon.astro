---
import { icons, type IconName } from '../lib/icons';
interface Props { name: IconName; size?: 'sm' | 'md'; class?: string; label?: string }
const { name, size = 'md', class: cls = '', label } = Astro.props;
---
<svg
  class:list={['icon', size === 'sm' && 'icon--sm', cls]}
  viewBox="0 0 24 24"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={icons[name]}
/>
