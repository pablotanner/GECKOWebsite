---
// Placeholder mark: survey corner markers around a verified position.
// The author will replace it (public/assets/logo.svg is the standalone file).
interface Props { href?: string; label?: string }
const { href = '#top', label = 'GECKOGuard, back to top' } = Astro.props;
---
<a class="logo" href={href} aria-label={label}>
  <svg class="logo__mark" viewBox="0 0 32 32" fill="none" aria-hidden="true">
    <g class="logo__corner" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 11V6a2 2 0 0 1 2-2h5" /><path d="M21 4h5a2 2 0 0 1 2 2v5" />
      <path d="M28 21v5a2 2 0 0 1-2 2h-5" /><path d="M11 28H6a2 2 0 0 1-2-2v-5" />
    </g>
    <circle class="logo__dot" cx="16" cy="16" r="7" />
    <path class="logo__tick" d="m12.75 16.25 2.25 2.25 4.25-4.75" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  <span class="logo__word">GECKOGuard</span>
</a>
