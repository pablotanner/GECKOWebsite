---
import Icon from '../components/Icon.astro';
import VideoTabs from '../components/VideoTabs.astro';
import { videos } from '../config';
import type { IconName } from '../lib/icons';

const helps: { icon: IconName; text: string }[] = [
  { icon: 'server', text: 'It finds out which login server the network is registered to use, over a public, password-free onboarding login.' },
  { icon: 'key', text: 'It sends your password only to that server, checked automatically.' },
  { icon: 'ban', text: 'There is no "Trust" button for the user to tap by mistake or laziness.' },
];
---
<section class="section enterprise" id="enterprise" aria-labelledby="enterprise-title">
  <div class="container enterprise__grid">
    <div class="enterprise__copy">
      <h2 class="display-2" id="enterprise-title">It's worse for enterprise WiFi.</h2>
      <p class="lead">
        On eduroam and company networks, your phone sends your password to whichever server answers.
        An impostor answers with its own certificate, and the phone shows a <q>Trust this certificate?</q> prompt. One tap, and the password is gone.
      </p>
      <p class="enterprise__context">
        The videos show two ways it happens. Joining for the first time, a phone without a profile shows the same prompt
        for the real network, so accepting it is what everyone does; Android even suggests <q>Trust on first use</q>.
        Already connected, the impostor knocks the phone off the network, and when it reconnects the prompt looks innocent:
        the user may feel required to trust it in order to get back online.
      </p>
      <div class="enterprise__helps">
        <p class="label">How GECKOGuard helps</p>
        <ul class="enterprise__list">
          {helps.map((h) => (
            <li><Icon name={h.icon} /><span>{h.text}</span></li>
          ))}
        </ul>
      </div>
    </div>
    <div class="enterprise__media">
      <VideoTabs
        label="Attack videos"
        items={[
          {
            id: 'video-eduroam-android', label: 'First connection', detail: 'Android tablet', video: videos.eduroamAndroid,
            why: {
              q: 'Why a first connection?',
              a: 'It is the most vulnerable moment on any device, Android or iPhone: there is no profile yet to compare the server\'s certificate with, so the device has to ask.',
            },
          },
          {
            id: 'video-eduroam', label: 'Reconnecting', detail: 'iPhone', video: videos.eduroam,
            why: {
              q: 'Why an iPhone?',
              a: 'Reconnecting attacks are most exposed on iOS: one prompt, one tap. On Android the user has to manually select “Trust on first use”, as well as the security type for downgrade attacks, again; there is no automatic prompt like on iOS. However, if an impatient user decides to tap on “Forget network”, it will take them back to the vulnerable first connection scenario.',
            },
          },
        ]}
      />
    </div>
  </div>
</section>

<style>
  .enterprise__grid { display: grid; gap: var(--space-12); }
  .enterprise__copy { display: grid; gap: var(--space-8); align-content: start; }
  .enterprise__helps { display: grid; gap: var(--space-4); }
  .enterprise__context { max-width: var(--measure-lead); color: var(--color-text-secondary); margin-top: calc(-1 * var(--space-4)); }
  .enterprise__list { list-style: none; display: grid; }
  .enterprise__list li {
    display: grid; grid-template-columns: auto 1fr; gap: var(--space-4); align-items: start;
    padding-block: var(--space-4);
    border-top: var(--border-hairline) solid var(--color-border-default);
    max-width: var(--measure-lead);
  }
  .enterprise__list :global(.icon) { color: var(--color-accent-default); margin-top: var(--space-1); }
  .enterprise__media { width: 100%; max-width: 20rem; justify-self: center; }
  @media (min-width: 56em) {
    .enterprise__grid { grid-template-columns: 7fr 4fr; gap: var(--space-16); align-items: start; }
    .enterprise__media { justify-self: end; }
  }
</style>
