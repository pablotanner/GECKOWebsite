---
import Icon from '../components/Icon.astro';
import { site } from '../config';
import { url } from '../lib/url';

const faqs: { q: string; a: string; tbc?: boolean }[] = [
  {
    q: 'What is required for a network to participate?',
    a: 'TODO: Whitelisting explanation',
  },
];
---
<section class="section" id="faq" aria-labelledby="faq-title">
  <div class="container faq__grid">
    <header class="faq__head">
      <h2 class="display-2" id="faq-title">Questions and Answers</h2>
      <p class="lead">Additional information about GECKOGuard</p>
      <!-- <p><a href={url('technical/')}>For the curious: how it works in detail</a></p> -->
    </header>
    <div class="accordion">
      {faqs.map((f, i) => (
        <div class="accordion__item">
          <h3>
            <button class="accordion__trigger" type="button" aria-expanded="false" aria-controls={`faq-${i}`} id={`faq-${i}-t`}>
              {f.q}
              <Icon name="chevron" />
            </button>
          </h3>
          <div class="accordion__panel" id={`faq-${i}`} role="region" aria-labelledby={`faq-${i}-t`} hidden>
            <p set:html={f.a} />
            {f.tbc && <p class="caption faq__tbc">TODO (CHECK)</p>}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('#faq .accordion__trigger').forEach((t) => {
    t.addEventListener('click', () => {
      const open = t.getAttribute('aria-expanded') !== 'true';
      t.setAttribute('aria-expanded', String(open));
      const panel = document.getElementById(t.getAttribute('aria-controls')!);
      if (panel) panel.hidden = !open;
    });
  });
</script>

<style>
  .faq__grid { display: grid; gap: var(--space-10); }
  .faq__head { display: grid; gap: var(--space-4); align-content: start; }
  .faq__tbc { margin-top: var(--space-3); }
  @media (min-width: 56em) {
    .faq__grid { grid-template-columns: 5fr 7fr; gap: var(--space-16); }
    .faq__head { position: sticky; top: calc(var(--layout-nav-height) + var(--space-8)); }
  }
</style>
