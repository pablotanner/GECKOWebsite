---
import Icon from '../components/Icon.astro';
import Chip from '../components/Chip.astro';
---
<section class="hero survey-grid" id="top" aria-labelledby="hero-title">
  <div class="container hero__inner">
    <div class="hero__copy">
      <h1 class="display-1" id="hero-title">Is this WiFi really who it says it is?</h1>
      <p class="lead">
        GECKOGuard checks every network against a public register of who is allowed to run which WiFi,
        where. Impostors get caught before you type anything.
      </p>
      <div class="cluster">
        <a class="btn btn--primary" href="#demo">See the attack <Icon name="arrowDown" size="sm" /></a>
        <a class="btn btn--secondary" href="#how-it-works">How it works</a>
      </div>
    </div>

    <figure class="hero__figure">
      <div class="phone" role="img" aria-label="A phone's WiFi list showing two networks both called Skyport Free WiFi. One is marked Verified, the other Conflict. A third network, BeanThere Guest, is Unverified.">
        <div class="phone__screen" aria-hidden="true">
          <div class="phone__status"><span>09:41</span><span>Skyport Terminal</span></div>
          <div class="phone__header">
            <p class="title">WiFi</p>
            <p class="caption">Checked by GECKOGuard</p>
          </div>
          <div class="phone__body">
            <div class="network" data-verdict="verified">
              <span class="network__icon"><Icon name="wifi" /></span>
              <span class="network__ssid">Skyport Free WiFi</span>
              <span class="network__meta"><Chip verdict="verified" /></span>
            </div>
            <div class="network" data-verdict="conflict">
              <span class="network__icon"><Icon name="wifi" /></span>
              <span class="network__ssid">Skyport Free WiFi</span>
              <span class="network__meta"><Chip verdict="conflict" /></span>
            </div>
            <div class="network" data-verdict="unverified">
              <span class="network__icon"><Icon name="wifi" /></span>
              <span class="network__ssid">BeanThere Guest</span>
              <span class="network__meta"><Chip verdict="unverified" /></span>
            </div>
            <p class="hero__why">
              Same name, but its sign-in page isn't the one registered for this terminal.
            </p>
          </div>
        </div>
      </div>
    </figure>
  </div>
</section>

<style>
  .hero {
    border-bottom: var(--border-hairline) solid var(--color-border-default);
    padding-block: var(--space-12) var(--space-16);
  }
  .hero__inner { display: grid; gap: var(--space-12); align-items: center; }
  .hero__copy { display: grid; gap: var(--space-6); }
  .hero__figure { justify-self: center; width: min(100%, 19rem); }
  .hero__figure .phone { width: 100%; }
  .hero__why {
    margin-top: var(--space-2);
    padding: var(--space-3);
    border-radius: var(--radius-md);
    background: var(--color-surface-sunken);
    font-size: var(--text-xs);
    line-height: var(--leading-snug);
    color: var(--color-text-secondary);
  }
  @media (min-width: 56em) {
    .hero { padding-block: var(--space-20) var(--space-24); }
    .hero__inner { grid-template-columns: 7fr 5fr; gap: var(--space-16); }
    .hero__figure { justify-self: end; width: min(100%, 20rem); }
  }
</style>
